[Unit]
Description=Prepare Japanese input and dictation for new Omarchy users
After=local-fs.target omarchy-provision-owner.service
Before=display-manager.service
[Service]
Type=oneshot
ExecStart=/usr/bin/python /usr/local/share/omarchy-jp/jp_defaults.py
RemainAfterExit=yes
[Install]
WantedBy=graphical.target
